# ─── CivicLedger Vercel Environment Variables ────────────────────────────────
# Set these in Vercel Dashboard → Settings → Environment Variables

# PostgreSQL connection string (use Neon, Supabase, Railway, or any PostgreSQL provider)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT secret key – generate a strong random string (min 32 chars)
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars

# JWT algorithm
ALGORITHM=HS256

# Token expiration in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Admin registration secret key
ADMIN_SECRET_KEY=admin-registration-secret-key-2024

# Optional: comma-separated list of additional allowed CORS origins
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
